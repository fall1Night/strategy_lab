# 数据库连接串（DB 无关，靠 DATABASE_URL 切换）
# 未设置时默认：sqlite:///./strategy_lab.db（零额外依赖，仅 Python 标准库）
#
# 本地开发（默认，推荐先验证）：
# DATABASE_URL=sqlite:///./strategy_lab.db
#
# MySQL（需先 pip install pymysql）：
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/strategylab
#
# PostgreSQL（需先 pip install psycopg2-binary）：
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/strategylab

# ---- 运行时目录 / 资源 ----
# 行情缓存 CSV 与渲染视图 HTML 的基目录（默认 ./data，自动创建，已 gitignore）
# STRATEGALAB_DATA_DIR=./data

# 用户自定义策略目录（放 *.toml / *.json）；不设置则只用包内置策略
# STRATEGALAB_STRATEGIES_DIR=./strategies

# 日志级别（DEBUG / INFO / WARNING / ERROR，默认 INFO）
# STRATEGALAB_LOG_LEVEL=INFO

# ---- 多数据源配置（P0/P1） ----
# 全局默认数据源（默认 eastmoney，支持: eastmoney | akshare | tushare）
# STRATEGALAB_DATA_SOURCE=eastmoney

# 按品种覆盖数据源（可选，逗号分隔多对，冒号分隔 symbol:source）
# 例：600216.SH 走 tushare，000001.SZ 走 akshare
# STRATEGALAB_SYMBOL_SOURCE=600216.SH:tushare,000001.SZ:akshare

# 容灾备用源顺序（可选，主源失败时的切换顺序，逗号分隔）
# 例：主源东财失败 → 先切 akshare → 再切 tushare
# STRATEGALAB_FALLBACK_SOURCES=akshare,tushare

# tushare 凭证（使用 tushare 时需注册并填写）
# STRATEGALAB_TUSHARE_TOKEN=your_token_here

# 自动故障转移开关（auto=启用 / off=关闭，默认 auto）
# STRATEGALAB_DATASOURCE_FAILOVER=auto

# 熔断总开关（on=启用 / off=关闭，默认 on；排查问题时临时关闭）
# STRATEGALAB_DATASOURCE_CB=on
