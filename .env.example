# 数据库连接串（DB 无关，靠 DATABASE_URL 切换）
# 未设置时默认：sqlite:///./strategy_lab.db（零额外依赖，仅 Python 标准库）
#
# 本地开发（默认，推荐先验证）：
# DATABASE_URL=sqlite:///./strategy_lab.db
#
# MySQL（需先 pip install pymysql）：
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/strategylab
#
# PostgreSQL（需先 pip install psycopg2-binary）：
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/strategylab

# ---- 运行时目录 / 资源 ----
# 行情缓存 CSV 与渲染视图 HTML 的基目录（默认 ./data，自动创建，已 gitignore）
# STRATEGALAB_DATA_DIR=./data

# 用户自定义策略目录（放 *.toml / *.json）；不设置则只用包内置策略
# STRATEGALAB_STRATEGIES_DIR=./strategies

# 日志级别（DEBUG / INFO / WARNING / ERROR，默认 INFO）
# STRATEGALAB_LOG_LEVEL=INFO
